# Server
PORT=3001

# Base de données
# Vercel : Storage → Marketplace → Neon (Postgres) ou PlanetScale (MySQL)
# Les variables DATABASE_URL / POSTGRES_URL sont injectées automatiquement.
# POSTGRES_URL=postgresql://...
# MYSQL_URL=mysql://...
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=mayn

# Premier déploiement prod : true pour créer les tables, puis false ou supprimer
# DB_SYNCHRONIZE=true

# Frontend (CORS)
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=changez-moi-en-production
JWT_EXPIRES_IN=7d

# Compte admin (créé / synchronisé au démarrage)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin123@

# Rôles utilisateur : customer | admin | artiste | commande
# Assigner artiste/commande via /admin/users après connexion admin

# Importer les 36 tableaux au 1er démarrage (si table vide)
# SEED_PAINTINGS=true

# Vercel prod : Storage → Blob sur dahbi-art-api (injecte BLOB_READ_WRITE_TOKEN)
# BLOB_READ_WRITE_TOKEN=

# Commandes & paiement
SHIPPING_FLAT_EUR=0
SHIPPING_DELAY_DAYS=3
# Sans Stripe : CHECKOUT_DEV_MODE=true simule le paiement (local)
CHECKOUT_DEV_MODE=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  (frontend .env.local)

# Notifications équipe commandes (nouvelle commande payée)
# COMMANDE_NOTIFY_EMAILS=commandes@example.com,admin@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@mayn.art
